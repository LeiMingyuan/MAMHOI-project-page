{
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["reviewer"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    }
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow, noarchive",
    "Cache-Control": "no-store"
  }
}